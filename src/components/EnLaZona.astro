---
import { ruta } from '../data/rutas';
import { fotosZona } from '../data/zona';

/**
 * El pasillo.
 *
 * Dos rieles de tarjetas vienen desde el fondo hacia quien mira. La
 * perspectiva sola hace lo que parecen dos animaciones: según crece la z de
 * una tarjeta se hace más grande **y** su x en pantalla se abre desde el punto
 * de fuga, porque la proyección escala posición y tamaño por el mismo factor.
 *
 * Tres cosas dan la forma, y cada una arregla un defecto concreto:
 *
 * 1. La profundidad se escribe como **tamaño aparente**, geométricamente: cada
 *    tarjeta es una proporción constante mayor que la de detrás. Repartiendo
 *    la z linealmente, las de delante se separan unas de otras según la
 *    proyección las agranda, y la cinta se rompe.
 * 2. Los rieles abren fuerte al principio y luego aguantan (`fan` > 1). Esa
 *    apertura cancela el crecimiento —todavía lento— del fondo, así que la
 *    cinta sale del centro como una banda plana, dobla una vez, y solo
 *    entonces se va en diagonal. Con rieles paralelos sale un cono recto.
 * 3. Ninguno de los dos extremos del bucle se ve nunca. Una tarjeta muere con
 *    su borde interior pasado el 50 % del ancho, fuera del cuadro. Y nace
 *    **cruzada**: `nacimiento` es negativo, así que la más nueva empieza al
 *    otro lado y barre de vuelta por el centro. Eso tapa la garganta —el eje
 *    queda cubierto en todo momento— y la recién nacida aparece detrás de
 *    otras que ya lo cubren, así que no necesita desvanecerse al entrar.
 *
 * 4. **En vertical la geometría es otra, no la misma más grande.** El efecto
 *    es ancho por naturaleza y una pantalla de teléfono es alta. Escalar el
 *    espacio entero agranda también el recorrido lateral, y las tarjetas
 *    grandes —las de delante— salen de cuadro antes de que se las vea: la
 *    sección se queda en un hilo. Así que en vertical viajan **menos de lado
 *    y crecen más**, con su propio juego de fotogramas.
 *
 * Todo se mide en `cqw`, que es un porcentaje del ancho del contenedor, así
 * que el pasillo guarda sus proporciones a cualquier tamaño.
 *
 * **Sin JavaScript.** Los fotogramas clave se calculan aquí, en el build, y
 * viajan como CSS. En el navegador no corre nada: lo mueve el compositor.
 */
interface Props {
  /**
   * Tarjetas por riel. Más tarjetas es un pasillo más denso, no más rápido.
   *
   * Por defecto, la mitad de las fotografías que haya: los dos rieles reparten
   * la lista en vez de repetirla, así que con ocho por riel salen las
   * dieciséis piezas de la serie y ninguna se ve dos veces a la vez.
   */
  tarjetas?: number;
  /** Segundos que tarda una tarjeta en recorrer el pasillo entero. */
  velocidad?: number;
  /** Altura del eje del pasillo en horizontal, en porcentaje de la altura. */
  eje?: number;
  /** Y en vertical, donde el reparto de la pantalla es otro. */
  ejeMovil?: number;
}
const { tarjetas = Math.ceil(fotosZona.length / 2), velocidad = 22, eje = 52, ejeMovil = 55 } = Astro.props;

/** Geometría del pasillo en horizontal. Cada longitud, en `cqw`. */
const BASE = {
  perspectiva: 30,
  anchoTarjeta: 18,
  /**
   * 18 × 22,5 es 4:5, la proporción nativa de las piezas de la serie. Con
   * cualquier otra, `object-fit: cover` se come el rótulo «EN LA ZONA» de
   * arriba o el nombre de abajo, que son parte del diseño de la tarjeta.
   *
   * Solo cambia la forma de la tarjeta, no el recorrido: `altoAlNacer` y
   * `altoAlSalir` son tamaños EN PANTALLA y la escala se deriva de ellos.
   */
  altoTarjeta: 22.5,
  radio: 0.4,
  altoAlNacer: 2.6,
  altoAlSalir: 46,
  nacimiento: -11,
  salida: 44,
  fan: 3.3,
  giroAlNacer: 6,
  giroAlSalir: 28,
  /** Paradas con que se traza la curva. Subir solo si el movimiento se ve facetado. */
  paradas: 18,
  /** Hasta donde va entera, y donde acaba de apagarse. Ver `opacidad`. */
  enteraHasta: 0.68,
  apagadaEn: 0.95,
};

/**
 * La opacidad a lo largo del recorrido.
 *
 * **Entera durante casi todo el viaje.** Las tarjetas son piezas de la marca,
 * con su rótulo y su nombre dentro: translúcidas se leen como un fondo, y lo
 * que son es el contenido de la sección.
 *
 * Y se va **al final**, cuando la tarjeta ya está encima de quien mira. Ahí es
 * justo donde el giro llega a 28° y el trapecio de la perspectiva se pone más
 * agresivo — la foto no se deforma, pero un rectángulo tan girado y tan cerca
 * lo parece. Desvanecerla remata el recorrido en vez de cortarlo con el borde
 * del cuadro, y de paso se lleva ese fotograma.
 */
function opacidad(u: number, P: { enteraHasta: number; apagadaEn: number }): number {
  if (u <= P.enteraHasta) return 1;
  const t = Math.min(1, (u - P.enteraHasta) / (P.apagadaEn - P.enteraHasta));
  // Se va despacio al principio y deprisa al final: apagarla en linea recta
  // se nota como un escalon justo cuando la tarjeta es mas grande.
  return Math.pow(1 - t, 1.6);
}

/** Se muestrea la curva una vez para que los fotogramas la sigan de verdad. */
function fotogramas(sentido: 1 | -1, nombre: string, P: typeof BASE): string {
  const pasos: string[] = [];
  for (let s = 0; s <= P.paradas; s++) {
    const u = s / P.paradas;
    // Geométrico en tamaño aparente: dos tarjetas seguidas guardan siempre la
    // misma proporción y la cinta no se abre por ningún lado.
    const escala = (P.altoAlNacer / P.altoTarjeta) * Math.pow(P.altoAlSalir / P.altoAlNacer, u);
    const z = P.perspectiva * (1 - 1 / escala);
    const riel = P.salida - (P.salida - P.nacimiento) * Math.pow(1 - u, P.fan);
    const giro = P.giroAlNacer + (P.giroAlSalir - P.giroAlNacer) * u;
    pasos.push(
      `${(u * 100).toFixed(1)}%{transform:translate3d(${(sentido * riel).toFixed(2)}cqw,0,` +
      `${z.toFixed(2)}cqw) rotateY(${(-sentido * giro).toFixed(1)}deg);` +
      `opacity:${opacidad(u, P).toFixed(3)}}`,
    );
  }
  return `@keyframes ${nombre}{${pasos.join('')}}`;
}

/**
 * Y la geometría en vertical.
 *
 * El pasillo es ancho por naturaleza y la pantalla de un teléfono es alta, así
 * que con la geometría de escritorio queda un hilo flotando en medio de una
 * pantalla vacía. Escalar el espacio entero no lo arregla: agranda también el
 * recorrido lateral, y las tarjetas grandes —las de delante— salen de cuadro
 * antes de que se las vea. Lo que hay que hacer es lo contrario: que **viajen
 * menos de lado y crezcan más**, para que sigan dentro del encuadre cuando ya
 * son grandes.
 */
const MOVIL = {
  ...BASE,
  salida: 20,
  altoAlSalir: 100,
  fan: 2.6,
  /**
   * Y se apaga mas tarde que en horizontal.
   *
   * En vertical las tarjetas del fondo son diminutas: casi toda la banda que
   * se ve son las de delante. Con el desvanecido de escritorio —que empieza en
   * el 68 % del recorrido— se apagaba justo lo que da peso a la seccion, y
   * quedaba lavada. Aqui solo se va la ultima, que es la que de verdad esta
   * encima de quien mira.
   */
  enteraHasta: 0.82,
  apagadaEn: 1,
};

const rieles = [
  { clase: 'zona__tarjeta--der', sentido: 1 as const, enAncho: 'zona-der', enAlto: 'zona-der-m' },
  { clase: 'zona__tarjeta--izq', sentido: -1 as const, enAncho: 'zona-izq', enAlto: 'zona-izq-m' },
];
const css = rieles
  .map((r) => fotogramas(r.sentido, r.enAncho, BASE) + fotogramas(r.sentido, r.enAlto, MOVIL))
  .join('');

/**
 * La caja de la tarjeta sale de la MISMA tabla que la curva.
 *
 * Escrita a mano en el CSS, un día se cambia `altoTarjeta` aquí arriba, la
 * regla se queda con el número viejo y la tarjeta deja de encajar con el
 * recorrido sin que nada avise. Ninguna de estas depende del ancho de la
 * pantalla, así que ir en línea —que es lo que hace `define:vars`— no estorba.
 */
const caja = {
  ancho: `${BASE.anchoTarjeta}cqw`,
  alto: `${BASE.altoTarjeta}cqw`,
  sangraX: `${-BASE.anchoTarjeta / 2}cqw`,
  sangraY: `${-BASE.altoTarjeta / 2}cqw`,
  radio: `${BASE.radio}cqw`,
  perspectiva: `${BASE.perspectiva}cqw`,
};
---

<style is:inline set:html={css}></style>

<div class="zona" aria-hidden="true">
  <div class="zona__espacio">
    {rieles.map((riel, r) =>
      Array.from({ length: tarjetas }, (_, i) => {
        // Cada riel toma SU tramo de la lista, no la misma. Con la misma, el
        // pasillo enseña la misma cara a izquierda y derecha a la vez, y con
        // dieciséis piezas de las que solo salían siete.
        const foto = fotosZona[(r * tarjetas + i) % fotosZona.length];
        return (
          <div
            class:list={['zona__tarjeta', riel.clase]}
            /* El nombre de la animación NO va aquí: un estilo en línea gana a
               cualquier regla, y en vertical el riel cambia de geometría. */
            style={`animation-duration:${velocidad}s;` +
              /* El retraso negativo suelta cada tarjeta a mitad de vuelo, así
                 que el pasillo ya está lleno en el primer fotograma. */
              `animation-delay:${(-(i * velocidad) / tarjetas).toFixed(2)}s`}
          >
            <img src={ruta(foto.src)} alt="" loading="lazy" decoding="async" width="420" height="525" />
          </div>
        );
      }),
    )}
  </div>
</div>

<style define:vars={{ ejeAncho: `${eje}%`, ejeAlto: `${ejeMovil}%`, ...caja }}>
  .zona {
    /* `define:vars` escribe sus variables EN LÍNEA sobre el elemento, y un
       estilo en línea gana a cualquier media query. Así que las dos medidas
       entran por su propio nombre —tal cual lo escribe `define:vars`, en
       camelCase— y `--eje`, la que de verdad se usa, solo la fija esta hoja,
       que sí puede cambiar de opinión según el ancho. */
    --eje: var(--ejeAncho);
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* `cqw` se mide contra esto. */
    container-type: inline-size;
    /* La banda de arriba se recorta ENTERA: es donde vive el titular.
       Un velo por encima no vale — con `preserve-3d`, las tarjetas que vienen
       hacia quien mira se pintan por delante de cualquier hermano posterior, y
       medido dejaban un pixel de brillo 193 justo detras del texto. La
       mascara, en cambio, no las tapa: las recorta, y ahi no hay nada que
       leer por encima. Abajo se desvanece para que no terminen en un corte. */
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      transparent 27%,
      #000 46%,
      #000 97%,
      transparent 100%
    );
  }
  .zona__espacio {
    position: absolute;
    inset: 0;
    perspective: var(--perspectiva);
    perspective-origin: 50% var(--eje);
    transform-style: preserve-3d;
    z-index: 0;
  }
  .zona__tarjeta {
    position: absolute;
    left: 50%;
    top: var(--eje);
    width: var(--ancho);
    height: var(--alto);
    margin-left: var(--sangraX);
    margin-top: var(--sangraY);
    border-radius: var(--radio);
    overflow: hidden;
    backface-visibility: hidden;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    /* Nítidas. La opacidad la lleva la animación, que la baja solo al final;
       esto es el valor de partida por si los fotogramas no llegaran. */
    opacity: 1;
  }
  .zona__tarjeta--der { animation-name: zona-der; }
  .zona__tarjeta--izq { animation-name: zona-izq; }
  .zona__tarjeta img { width: 100%; height: 100%; object-fit: cover; display: block; }


  @media (max-width: 899px) {
    /* En vertical cambia el RECORRIDO, no el tamaño de nada.
       Estirar la tarjeta la recortaría por los lados y se comería el nombre;
       escalar el espacio entero agranda también el viaje lateral, y entonces
       las tarjetas grandes salen de cuadro antes de que se las vea: medido,
       la banda pintada se quedaba en 190 px de 844. Con su propio juego de
       fotogramas —menos viaje, más crecimiento— sube a 263. */
    .zona__tarjeta--der { animation-name: zona-der-m; }
    .zona__tarjeta--izq { animation-name: zona-izq-m; }
    .zona {
      --eje: var(--ejeAlto);
      /* Y la banda visible se ensancha: en vertical sobra alto, y recortar
         aquí como en horizontal dejaría el pasillo en un hilo. */
      mask-image: linear-gradient(
        180deg,
        transparent 0%,
        transparent 20%,
        #000 30%,
        #000 98%,
        transparent 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Pausar y no desactivar deja el pasillo entero: cada tarjeta ya está
       soltada a mitad de vuelo por su retraso negativo, así que se congela
       como una composición terminada en vez de amontonarse en el eje. */
    .zona__tarjeta { animation-play-state: paused; }
  }
</style>
