---
import { site } from '../data/site';
import { ruta } from '../data/rutas';
import { territorios } from '../data/territorios';
import { enlaceWhatsApp } from '../data/whatsapp';

const sitio = [
  { href: '/', texto: 'Inicio' },
  { href: '/contacto', texto: 'Contacto' },
];
const legales = [
  { href: '/privacidad', texto: 'Política de privacidad' },
  { href: '/aviso-legal', texto: 'Aviso legal' },
];
const telefonoE164 = `tel:+${site.whatsapp}`;
const anio = new Date().getFullYear();
---

{/*
  Bloque de marca a la izquierda —logotipo, eslogan, los cuatro servicios con
  su precio de entrada y el botón de reserva— y las columnas de enlaces a la
  derecha. Debajo, la línea legal.

  Los servicios salen de `src/data/territorios.ts`, que es la misma lista que
  pinta la tabla de la portada: escritos a mano aquí, se quedarían desfasados
  el día que cambie una tarifa (G1). Y por eso no se repiten como columna de
  enlaces: ya son enlaces.
*/}
<footer class="pie">
  <div class="pie__principal">
    <div class="pie__marca">
      <img
        class="pie__logo"
        src={ruta('/logo-safetory.webp')}
        alt={site.nombre}
        width="420"
        height="128"
        loading="lazy"
        decoding="async"
      />
      <p class="pie__eslogan">{site.eslogan}</p>

      <ul class="pie__servicios">
        {territorios.map((t) => (
          <li>
            <a href={ruta(t.href)}>
              <span class="pie__servicio">{t.nombre}</span>
              <span class="pie__desde">{t.desde || 'Consultar'}</span>
            </a>
          </li>
        ))}
      </ul>

      <a
        class="pie__cta"
        href={enlaceWhatsApp('Consulta general')}
        target="_blank"
        rel="noopener noreferrer"
      >
        Reservar por WhatsApp
      </a>
    </div>

    <div class="pie__columnas">
      <nav class="pie__col" aria-label="Secundaria">
        <p class="kicker">Estudio</p>
        {sitio.map((e) => <a href={ruta(e.href)}>{e.texto}</a>)}
      </nav>

      <nav class="pie__col" aria-label="Legal">
        <p class="kicker">Legal</p>
        {legales.map((e) => <a href={ruta(e.href)}>{e.texto}</a>)}
      </nav>

      <div class="pie__col">
        <p class="kicker">Contacto</p>
        <a href={telefonoE164}>{site.telefono}</a>
        <a href={`mailto:${site.correo}`}>{site.correo}</a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <address>{site.direccion}</address>
        <dl class="pie__horario">
          {site.horario.map((f) => (
            <div><dt>{f.dias}</dt><dd>{f.horas}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </div>

  <div class="pie__legal">
    <p class="pie__copia">© {anio} {site.nombre}</p>
    <a class="pie__autor" href="https://panaclaw.com" target="_blank" rel="noopener noreferrer">
      Página creada por panaclaw.com
    </a>
    <nav class="pie__legales" aria-label="Avisos">
      {legales.map((e) => <a href={ruta(e.href)}>{e.texto}</a>)}
    </nav>
  </div>
</footer>

<style>
  .pie {
    display: flex;
    flex-direction: column;
    gap: var(--phi-3);
    /* Holgura arriba: al llegar al final de la pagina, la pastilla del nav
       —que es fija— se planta justo encima del pie y con menos aire se comia
       el logotipo. */
    padding: var(--phi-5) var(--phi-3) var(--phi-2);
    border-top: 1px solid var(--hairline);
    max-width: 1600px;
    margin: 0 auto;
  }

  /* El reparto aureo del resto del sitio, tambien aqui. La parte MAYOR es la
     de los enlaces y no la de la marca: al reves, las tres columnas se
     quedaban con 525 px entre las tres y el correo se salia de la pagina. */
  .pie__principal {
    display: grid;
    /* En `fr` y no en `%`: dos porcentajes que suman 100 mas un `gap` piden
       mas ancho del que hay, y el sobrante —los 68 px del hueco— sale por la
       derecha de la pagina. Con fracciones, el hueco se descuenta primero. */
    grid-template-columns: minmax(0, 0.382fr) minmax(0, 0.618fr);
    gap: var(--phi-4);
    align-items: start;
  }

  .pie__marca { display: flex; flex-direction: column; align-items: flex-start; gap: var(--phi-1); }
  .pie__logo { width: clamp(120px, 14vw, 168px); height: auto; }
  .pie__eslogan {
    font-family: var(--display);
    font-size: var(--phi-2);
    max-width: min(24ch, 100%);
  }

  .pie__servicios {
    list-style: none;
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    margin-top: var(--phi-0);
  }
  .pie__servicios a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--phi-1);
    padding: var(--phi-0) 0;
    border-top: 1px solid var(--hairline);
  }
  .pie__servicios li:last-child a { border-bottom: 1px solid var(--hairline); }
  .pie__servicio { font-family: var(--display); font-size: var(--phi-2); }
  .pie__desde { color: var(--ash); font-size: max(var(--phi-0), 0.75rem); }
  .pie__servicios a:hover .pie__servicio { color: var(--rec); }

  .pie__cta {
    margin-top: var(--phi-1);
    padding: var(--phi-1) var(--phi-3);
    border: 1px solid var(--rec);
    border-radius: 999px;
    color: var(--rec);
    font-weight: 500;
    transition: background 0.25s, color 0.25s;
  }
  .pie__cta:hover { background: var(--rec); color: var(--void); }

  .pie__columnas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--phi-3) var(--phi-2);
  }
  .pie__col { display: flex; flex-direction: column; gap: var(--phi-0); align-items: flex-start; }
  /* Un correo no tiene donde partir: sin esto, la palabra sola desborda su
     columna en cuanto la pantalla se estrecha. */
  .pie__col a, address { color: var(--ash); font-style: normal; overflow-wrap: anywhere; }
  .pie__horario { color: var(--ash); font-size: max(var(--phi-0), 0.75rem); }
  .pie__horario div { display: flex; justify-content: space-between; gap: var(--phi-1); }

  /* Un enlace de una linea levanta 23 px de caja: un pixel por debajo del
     objetivo tactil minimo. El relleno los pone en 26 sin mover el ritmo. */
  .pie a {
    display: inline-block;
    padding-block: 2px;
    transition: color 0.25s;
  }
  .pie .pie__col a:hover { color: var(--bone); }

  .pie__legal {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--phi-1) var(--phi-2);
    padding-top: var(--phi-1);
    border-top: 1px solid var(--hairline);
  }
  .pie__copia,
  .pie__autor,
  .pie__legales a { color: var(--ash); font-size: max(var(--phi-0), 0.75rem); }
  /* La linea legal va en cuerpo menor, asi que necesita mas relleno que el
     resto para llegar al objetivo tactil minimo. */
  .pie .pie__autor, .pie .pie__legales a { padding-block: 5px; }
  .pie__autor { justify-self: center; }
  .pie .pie__autor:hover, .pie .pie__legales a:hover { color: var(--bone); }
  .pie__legales { display: flex; flex-wrap: wrap; gap: var(--phi-2); justify-self: end; }

  @media (max-width: 899px) {
    /* Apilado, y en el mismo orden que se lee: marca, enlaces, legal. */
    .pie__principal { grid-template-columns: 1fr; gap: var(--phi-3); }
    .pie__columnas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Contacto ocupa las dos columnas: en media, el correo se partia por la
       mitad de la palabra y el horario perdia su alineacion a dos lados. */
    .pie__columnas > :last-child { grid-column: 1 / -1; }
    .pie__legal {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: var(--phi-0);
    }
    .pie__autor, .pie__legales { justify-self: start; }
  }
</style>
