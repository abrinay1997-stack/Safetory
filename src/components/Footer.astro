---
import { site } from '../data/site';
import { ruta } from '../data/rutas';

const secciones = [
  { href: '/estudio', texto: 'Estudio' },
  { href: '/ciclorama', texto: 'Ciclorama' },
  { href: '/produccion', texto: 'Producción' },
  { href: '/membresia', texto: 'Membresía' },
  { href: '/contacto', texto: 'Contacto' },
];
const legales = [
  { href: '/privacidad', texto: 'Política de privacidad' },
  { href: '/aviso-legal', texto: 'Aviso legal' },
];
const telefonoE164 = `tel:+${site.whatsapp}`;
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="pie__marca">
    <img
      class="pie__logo"
      src={ruta('/logo-safetory.webp')}
      alt={site.nombre}
      width="420"
      height="128"
      loading="lazy"
      decoding="async"
    />
    <p class="pie__eslogan">{site.eslogan}</p>
  </div>

  <div class="pie__rejilla">
    <div class="pie__col">
      <p class="kicker">Dónde</p>
      <address>{site.direccion}</address>
    </div>

    <div class="pie__col">
      <p class="kicker">Cuándo</p>
      <dl class="pie__horario">
        {site.horario.map((f) => (
          <div><dt>{f.dias}</dt><dd>{f.horas}</dd></div>
        ))}
      </dl>
    </div>

    <div class="pie__col">
      <p class="kicker">Contacto</p>
      <a href={telefonoE164}>{site.telefono}</a>
      <a href={`mailto:${site.correo}`}>{site.correo}</a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>

    <nav class="pie__col" aria-label="Secundaria">
      <p class="kicker">Secciones</p>
      {secciones.map((e) => <a href={ruta(e.href)}>{e.texto}</a>)}
    </nav>
  </div>

  <div class="pie__cierre">
    <p class="pie__copia">© {anio} {site.nombre}</p>
    <nav class="pie__legales" aria-label="Legal">
      {legales.map((e) => <a href={ruta(e.href)}>{e.texto}</a>)}
    </nav>
  </div>
</footer>

<style>
  .pie {
    display: flex;
    flex-direction: column;
    gap: var(--phi-3);
    padding: var(--phi-4) var(--phi-3) var(--phi-2);
    border-top: 1px solid var(--hairline);
  }

  /* El logotipo real y el eslogan abren el pie: antes empezaba directamente
     en «Dónde», sin nada que dijera de quién es el sitio. */
  .pie__marca { display: flex; flex-direction: column; gap: var(--phi-1); }
  .pie__logo { width: clamp(120px, 14vw, 168px); height: auto; }
  .pie__eslogan { color: var(--ash); font-size: var(--phi-1); max-width: 34ch; }

  .pie__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--phi-3);
  }
  .pie__col { display: flex; flex-direction: column; gap: var(--phi-0); }
  .pie__col a, address { color: var(--ash); font-style: normal; }
  .pie__col a:hover { color: var(--bone); }
  .pie__horario div {
    display: flex;
    justify-content: space-between;
    gap: var(--phi-1);
    color: var(--ash);
  }

  .pie__cierre {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--phi-1) var(--phi-2);
    padding-top: var(--phi-1);
    border-top: 1px solid var(--hairline);
  }
  .pie__copia, .pie__legales a { color: var(--ash); font-size: var(--phi-0); }
  .pie__legales { display: flex; flex-wrap: wrap; gap: var(--phi-2); }
  .pie__legales a:hover { color: var(--bone); }
</style>
