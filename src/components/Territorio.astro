---
import { ruta } from '../data/rutas';

interface Props {
  numero: string;
  nombre: string;
  /** Precio de entrada ya formateado, o cadena vacía si no hay dato (§9.5). */
  desde: string;
  href: string;
}
const { numero, nombre, desde, href } = Astro.props;

// Los cuatro enlaces de territorio son la navegación primaria de la portada.
// Sin la base, en el preview apuntan fuera del sitio: /estudio en vez de
// /Safetory/estudio. Se aplica aquí y no en las cuatro llamadas, para que sea
// un solo sitio el que tenga que acordarse. `ruta()` es idempotente.
const destino = ruta(href);
---

<li class="territorio">
  <a class="territorio__enlace" href={destino}>
    <span class="kicker territorio__numero">{numero}</span>
    <span class="territorio__nombre">{nombre}</span>
    <span class="territorio__desde">{desde || 'Consultar'}</span>
    <span class="territorio__ir" aria-hidden="true">Ver</span>
    <span class="sr-only">Ver {nombre}</span>
  </a>
</li>

<style>
  /* Una fila, no una pantalla.
     Los cuatro territorios ocupaban antes una sección entera cada uno, y los
     mismos cuatro nombres ya aparecían en el despiece justo encima: había que
     recorrer cinco pantallas para leer dos veces la misma lista. Como tabla,
     la respuesta —qué hay y desde cuánto— cabe de un vistazo. */
  .territorio { border-top: 1px solid var(--hairline); }
  .territorio:last-child { border-bottom: 1px solid var(--hairline); }

  .territorio__enlace {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: baseline;
    gap: var(--phi-2);
    padding: var(--phi-2) var(--phi-0);
    transition: background 0.25s;
  }
  .territorio__enlace:hover { background: rgba(237, 234, 227, 0.04); }

  .territorio__numero { color: var(--ash); }
  .territorio__nombre {
    font-family: var(--display);
    font-size: clamp(var(--phi-3), 4vw, var(--phi-4));
    line-height: 1;
    transition: color 0.25s;
  }
  .territorio__enlace:hover .territorio__nombre { color: var(--rec); }
  .territorio__desde { color: var(--ash); font-size: var(--phi-1); }
  .territorio__ir {
    font-size: var(--phi-0);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rec);
  }

  @media (max-width: 599px) {
    /* En una columna estrecha, número y flecha estorban más de lo que ayudan. */
    .territorio__enlace { grid-template-columns: 1fr auto; gap: var(--phi-0) var(--phi-1); }
    .territorio__numero, .territorio__ir { display: none; }
  }
</style>
