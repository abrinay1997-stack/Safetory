---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { site } from '../data/site';
import { ruta } from '../data/rutas';

interface Props {
  title: string;
  description: string;
  ruta: string;
  poster?: string;
  noindex?: boolean;
}

const { title, description, ruta: rutaProp, poster, noindex = false } = Astro.props;

// Los builds de preview (GitHub Pages) nunca se indexan: competirían con
// producción por el mismo contenido.
const ES_PREVIEW = import.meta.env.PUBLIC_PREVIEW === 'true';

const base = Astro.site ?? 'http://localhost:4321';
const tituloCompleto = title.includes(site.nombre) ? title : `${title} — ${site.nombre}`;
const canonica = new URL(ruta(rutaProp), base).toString();
const ogImagen = new URL(ruta(poster ?? '/posters/home.webp'), base).toString();
const esHome = rutaProp === '/';

// LocalBusiness con datos reales unicamente. Sin calificaciones (G1).
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nombre,
  description: site.eslogan,
  url: canonica,
  telephone: site.telefono,
  email: site.correo,
  sameAs: [site.instagram],
  // Coordenadas confirmadas por el cliente: es dato real, no una estimacion
  // sacada del nombre de la calle.
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lon,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Edificio Brasilia, Vía España',
    addressLocality: 'Panamá',
    addressRegion: 'Provincia de Panamá',
    addressCountry: 'PA',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '00:00',
      closes: '23:59',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '12:30',
    },
  ],
};
---

<!DOCTYPE html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    {(noindex || ES_PREVIEW) && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonica} />

    {/*
      Se precarga la fuente de titulares, y solo esa.

      Va como comentario de plantilla y no como comentario HTML: Astro emite
      los `<!-- -->` tal cual, asi que este texto viajaba entero a cada
      visitante en las seis rutas, y ademas contenia un `<h1>` literal que el
      test de «un solo h1 por pagina» contaba como encabezado de verdad.

      Medido con la API de LCP en el navegador: el elemento LCP de estas
      paginas NO es el poster, es el <h1>. Chrome descarta el poster como
      candidato por su bajisima entropia —8 KB para 1280x800— y se queda con
      el titular, que ocupa media pantalla.

      Eso decide las tres precargas:

      · Clash Display SI. Con `font-display: swap` el titular se pinta al
        instante con la fuente de respaldo, y cuando llega la real CAMBIA DE
        TAMANO: eso es un candidato a LCP nuevo y mas tardio, y ademas un
        salto de layout. Precargarla evita las dos cosas. Medido: quitarla
        empeoraba el LCP hasta medio segundo en las rutas mas largas.
      · Satoshi NO. Es el texto de cuerpo, mucho mas pequeno: su cambio de
        tipo no mueve el LCP y el salto que provoca es despreciable.
      · El poster NO. No es el elemento LCP, asi que precargarlo solo le
        quitaria ancho de banda a la fuente que si lo es. Ya lleva
        `fetchpriority="high"` en la propia etiqueta.
    */}
    <link rel="preload" href={ruta('/fonts/ClashDisplay-Semibold.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImagen} />

    <link rel="icon" type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23080808'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23FF2D2D'/%3E%3C/svg%3E" />

    <ClientRouter />

    {esHome && <script type="application/ld+json" set:html={JSON.stringify(negocio)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Nav ruta={rutaProp} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <SmoothScroll />
  </body>
</html>
