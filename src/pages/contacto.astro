---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bloque from '../components/Bloque.astro';
import Reveal from '../components/Reveal.astro';
import Escena3D from '../components/Escena3D.astro';
import { site } from '../data/site';
import { enlaceWhatsApp } from '../data/whatsapp';

const telefonoE164 = `tel:+${site.whatsapp}`;
// Las coordenadas exactas, no una busqueda por nombre de calle: Via Espana es
// una avenida larga.
const mapa = `https://www.google.com/maps/search/?api=1&query=${site.geo.lat}%2C${site.geo.lon}`;
---

<BaseLayout
  title="Contacto — Safetory Studio, Vía España, Panamá"
  description="Safetory Studio está en Edificio Brasilia, Vía España, Panamá. Abierto 24 horas de lunes a viernes y los sábados por la mañana."
  ruta="/contacto"
  poster="/posters/contacto.webp"
>
  <section class="hero">
    <Escena3D
      objeto="rotulo"
      temperatura="neutro"
      poster="/posters/contacto.webp"
      alt="Rótulo retroiluminado de Safetory Studio encendido sobre la pared del estudio."
      fondos={['/escena/sala.webp', '/escena/microfono.webp']}
    />
    <div class="hero__texto">
      <h1 data-titular>Contacto</h1>
    </div>
  </section>

  {/*
    La dirección y el mapa van juntos.

    Estaban en dos bloques seguidos y la dirección se leía tres veces en dos
    pantallas: el titular «Vía España, Panamá», la dirección completa, y otra
    vez lo mismo bajo «Cómo llegar». Un dato repetido tres veces no informa
    tres veces: parece un error.

    El mapa se incrusta con la ficha que facilitó el cliente el 2026-09-09. Se
    aparta del §5.6 del spec, que pedía imagen enlazada y prohibía el iframe
    por lo que cuesta un incrustado de terceros. Manda la instrucción del
    cliente, que aportó su propio mapa. Se paga el precio mínimo: carga
    diferida —el bloque está por debajo del pliegue—, `title` para que tenga
    nombre accesible, el referente recortado, y una caja con proporción fija,
    porque un iframe suelto entra con su alto por defecto y salta al cargar.
  */}
  <Bloque id="direccion" kicker="Dónde estamos">
    <h2 data-titular>Vía España, Panamá</h2>
    <address class="direccion">{site.direccion}</address>
    <div class="mapa">
      <iframe
        src={site.mapaIncrustado}
        title="Mapa con la ubicación de Safetory Studio en el Edificio Brasilia, Vía España, Panamá"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <a class="boton" href={mapa} target="_blank" rel="noopener noreferrer">
      Abrir en Google Maps
    </a>
  </Bloque>

  <Bloque id="canales" fondo="/fondos/microfono.webp" ladoFondo="derecha" kicker="Canales">
    <h2 data-titular>Escríbenos</h2>
    <Reveal>
      <a class="canal" href={telefonoE164}>{site.telefono}</a>
      <a class="canal" href={`mailto:${site.correo}`}>{site.correo}</a>
      <a class="canal" href={site.instagram} target="_blank" rel="noopener noreferrer">@safetorystudio</a>
    </Reveal>
  </Bloque>

  <Bloque id="horario" fondo="/fondos/interfaz.webp" ladoFondo="izquierda" kicker="Cuándo">
    <h2 data-titular>Horario</h2>
    <dl class="horario">
      {site.horario.map((f) => (
        <div><dt>{f.dias}</dt><dd>{f.horas}</dd></div>
      ))}
    </dl>
  </Bloque>

  <Bloque id="reservar" fondo="/fondos/lounge.webp" ladoFondo="derecha" kicker="Siguiente paso">
    <h2 data-titular>Reserva tu sesión</h2>
    <a class="boton" href={enlaceWhatsApp('Consulta general')} target="_blank" rel="noopener noreferrer">
      Reservar por WhatsApp
    </a>
  </Bloque>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100dvh; }
  .hero__texto {
    position: absolute;
    inset: auto 0 var(--phi-4) 0;
    padding: 0 var(--phi-3);
    display: flex;
    flex-direction: column;
    gap: var(--phi-0);
  }
  .direccion {
    font-style: normal;
    color: var(--ash);
    font-size: var(--phi-2);
    max-width: 26ch;
  }
  .canal {
    display: block;
    padding: var(--phi-1) 0;
    border-top: 1px solid var(--hairline);
    font-family: var(--display);
    /* A `--phi-3` fijo, «info@safetoryglobal.com» medía 525 px dentro de una
       columna de 306: la pagina entera se desplazaba en horizontal en el movil.
       La escala se mide contra el ancho de la pantalla, y aun asi se permite
       partir la palabra, porque un correo no tiene donde romper. */
    font-size: clamp(var(--phi-1), 7.5vw, var(--phi-3));
    overflow-wrap: anywhere;
    transition: color 0.25s;
  }
  .canal:hover { color: var(--rec); }
  .horario div {
    display: flex;
    justify-content: space-between;
    gap: var(--phi-1);
    padding: var(--phi-1) 0;
    border-top: 1px solid var(--hairline);
    font-size: var(--phi-2);
  }
  .horario dd { color: var(--ash); }
  /* El mapa lleva su propia caja con proporción fija: sin ella, el iframe
     entra con su alto por defecto y provoca un salto de layout al cargar. */
  .mapa {
    width: 100%;
    max-width: 46rem;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hairline);
    border-radius: var(--phi-0);
    overflow: hidden;
  }
  .mapa iframe { width: 100%; height: 100%; border: 0; display: block; }

  .boton {
    align-self: flex-start;
    padding: var(--phi-1) var(--phi-3);
    background: var(--rec);
    color: var(--void);
    font-weight: 500;
    border-radius: 999px;
  }
</style>
