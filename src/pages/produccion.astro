---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bloque from '../components/Bloque.astro';
import Reveal from '../components/Reveal.astro';
import Escena3D from '../components/Escena3D.astro';
import PrecioCard from '../components/PrecioCard.astro';
import { serviciosProduccion } from '../data/produccion';
import { enlaceWhatsApp } from '../data/whatsapp';
---

<BaseLayout
  title="Producción — Mixing, mastering y grabación en Panamá"
  description="Servicios de producción musical en Panamá: mixing con stems ilimitados, mastering, grabación y producción personalizada desde cero."
  ruta="/produccion"
  poster="/posters/produccion.webp"
>
  <section class="hero">
    <Escena3D
      objeto="interfaz"
      temperatura="ambar-apagado"
      poster="/posters/produccion.webp"
      alt="Interfaz de audio de sobremesa de Safetory, con el mando de nivel rodeado por un anillo rojo."
      fondos={['/escena/interfaz.webp', '/escena/sala.webp']}
    />
    <div class="hero__texto">
      <h1 data-titular>Producción</h1>
    </div>
  </section>

  {/*
    Los seis servicios en UNA pantalla, no en seis.

    Cada uno ocupaba una seccion entera a `100dvh` con una sola ficha de precio
    dentro, y detras venia una tabla comparativa que repetia los seis con su
    precio: ocho pantallas de negro para seis cifras. La rejilla dice lo mismo
    de un vistazo y la tabla desaparece, porque ya no compara nada que no este
    aqui al lado.

    La seccion sigue midiendo `100dvh` como el resto (G11): lo que cambia es
    que ahora cabe en una y no en ocho.
  */}
  {/* Sin fotografia al fondo, y por la misma razon que la tabla que habia
      aqui: la rejilla necesita el ancho completo para caber en tres columnas,
      y la foto ocupa el 38,2 % opuesto al texto. Con foto entraban dos
      columnas y tres filas, o sea otra vez dos pantallas. */}
  <Bloque id="servicios" kicker="Servicios">
    <h2 data-titular>Seis maneras de terminar un disco</h2>
    <Reveal>
      <ul class="servicios">
        {serviciosProduccion.map((servicio) => (
          <li id={servicio.id} class="servicios__ficha">
            <PrecioCard tarifa={servicio} />
          </li>
        ))}
      </ul>
    </Reveal>
  </Bloque>

  <Bloque id="reservar" fondo="/fondos/sala.webp" ladoFondo="derecha" kicker="Siguiente paso">
    <h2 data-titular>Empieza tu producción</h2>
    <a class="boton" href={enlaceWhatsApp('Servicios de producción')} target="_blank" rel="noopener noreferrer">
      Escribir por WhatsApp
    </a>
  </Bloque>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100dvh; }
  .hero__texto {
    position: absolute;
    inset: auto 0 var(--phi-4) 0;
    padding: 0 var(--phi-3);
    display: flex;
    flex-direction: column;
    gap: var(--phi-0);
  }
  /* La cifra baja un escalon dentro de la ficha: a 110 px se comia la rejilla
     entera y el nombre del servicio quedaba de nota al pie. */
  .servicios :global(.precio__cifra) { font-size: clamp(var(--phi-3), 5vw, var(--phi-4)); }
  .servicios {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--phi-1) var(--phi-3);
    list-style: none;
  }
  /* Tres columnas, no las que quepan: son SEIS fichas, y con `auto-fit` a
     1440 px salian cuatro arriba y dos abajo, con un hueco de dos columnas
     mirando al lector. Tres y tres se leen como una tabla. */
  @media (min-width: 600px) { .servicios { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .servicios { grid-template-columns: repeat(3, 1fr); } }

  .boton {
    align-self: flex-start;
    padding: var(--phi-1) var(--phi-3);
    background: var(--rec);
    color: var(--void);
    font-weight: 500;
    border-radius: 999px;
  }
</style>
